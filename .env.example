# Copie para .env e preencha os valores reais. Nunca commitar o .env de verdade.

# Banco de dados (bate com o docker-compose.yml local)
DATABASE_URL=postgresql://devlib:devlib@localhost:5432/devlib

# Autenticação
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_REFRESH_SECRET=troque-por-outro-valor-aleatorio-longo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# apps/api
PORT=3333
NODE_ENV=development

# Origem do apps/web liberada no CORS da API (opcional; padrão http://localhost:3000 se ausente)
WEB_URL=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3333
